# Authenticate with the App Store Connect API key (key_id / issuer_id / key PEM).
# The JSON path comes from .env (gitignored, see env.example); never commit
# the .p8 or this JSON. It must be the key for the ASC account that owns the
# gterm app record.
api_key_path(ENV["ASC_API_KEY_JSON"])

app_identifier("io.github.madeye.gterm")

# Read text from fastlane/metadata and images from fastlane/screenshots.
metadata_path("./fastlane/metadata")
screenshots_path("./fastlane/screenshots")

# Safety: review/verify before anything goes live.
submit_for_review(false)
automatic_release(false)
force(false) # show the HTML preview and ask for confirmation

# We are not shipping a binary from `deliver`; upload metadata + screenshots only.
skip_binary_upload(true)

# Replace the live screenshot set rather than appending to it.
overwrite_screenshots(true)

# gterm has no in-app purchases; the API-key precheck can't inspect IAPs and
# would otherwise exit non-zero on an otherwise successful run.
precheck_include_in_app_purchases(false)
